# Programmabbruch

def show_error():
    db.stop()
    hub.light.on(Color.RED)
    hub.display.text("!") 
    hub.light.on(Color.BLUE)
    
#Fahrdefinitionen    
    
def straight(distance, speed=1090, acc=900, wait=False,):
    db.reset()
    db.settings(straight_speed=speed)
    db.straight(distance, wait=wait)
    hub.light.on(Color.BLUE)
    while not db.done():
        if motorLeft.stalled() or motorRight.stalled():
            show_error()
            hub.display.icon(Icon.ARROW_UP)
            

def turnBothWheels(angle, trys=0, speed=800, acc=700, wait=True):
    db.reset()
    db.settings(turn_rate=speed, turn_acceleration=acc)
    offset = -2 if angle > 0 else 2
    db.turn(angle + offset, wait=wait)
    for i in range(trys):
        error = angle - hub.imu.heading()
        if abs(error) < 0.02:   
            break
        db.turn(error, wait=True)
    hub.light.on(Color.BLUE)

    
def turnOneWheel(angle,radius=124,speed=800,acc=700, wait=True):
    db.reset()
    db.settings(turn_rate=speed)
    db.curve(radius,angle, wait=wait)
    hub.light.on(Color.BLUE)


